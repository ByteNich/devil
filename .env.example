# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional (generated if not set)
SECRET_KEY=change-me-in-production-32chars

# Optional
MAX_SESSIONS=10
MODEL=claude-sonnet-4-5

# SSH execution (leave empty for local execution)
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
SSH_PASSWORD=

# Frontend URLs (change if deploying remotely)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
